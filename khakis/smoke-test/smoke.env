# Configuration shared by every service in the smoke test. Values are
# throwaway: nothing here reaches a real provider. Each variable maps onto a
# configuration key (FOO_BAR -> foo.bar, see Bootstrap.mergeProperties).

# Small heaps: a dozen JVMs share one CI runner.
JAVA_OPTS=-Xms64m -Xmx256m

CASSANDRA_KEYSPACE=dev
PARTITION_COUNT=32

# Cluster membership in ZooKeeper, as the deployment does it (unset means
# Cassandra).
CLUSTER_SERVICE_DAO=zookeeper
CLUSTER_ZK_HOST=zookeeper.eyeris

# Secrets and credentials the services refuse to start without.
IRIS_AES_SECRET=smoke-test-aes-secret-0123456789
IRIS_AES_IV=smoke-test-iv-01
QUESTIONS_AES_SECRET=smoke-test-questions-secret-0123
BILLING_API_KEY=smoke-test
BILLING_PUBLIC_API_KEY=smoke-test
EMAIL_PROVIDER_APIKEY=smoke-test
TWILIO_ACCOUNT_SID=smoke-test
TWILIO_ACCOUNT_AUTH=smoke-test
TWILIO_ACCOUNT_FROM=+15555550100
TWITTER_UNAME=smoke-test
IOS_APP_IDS=12345

# URLs the services build links and callbacks from. Nothing fetches them.
BILLING_URL=http://billing.invalid
REDIRECT_BASE_URL=http://web.invalid
WEBHOME_BASE_URL=http://web.invalid
STATIC_RESOURCE_SERVER_URL=http://static.invalid
STATIC_RESOURCE_BASE_URL=http://static.invalid
SECURE_STATIC_RESOURCE_BASE_URL=http://static.invalid
CAMERA_PREVIEW_BASEURL=http://camera.invalid
BOUNCE_ANDROID_URL=http://web.invalid
BOUNCE_APP_URL=http://web.invalid
BOUNCE_APPLE_URL=http://web.invalid
BOUNCE_HELP_URL=http://web.invalid
BOUNCE_REDIRECT_URL=http://web.invalid
BOUNCE_WEB_URL=http://web.invalid
TWILIO_CALLBACK_HOST=ivr.invalid
TWILIO_CALLBACK_SERVERURL=http://ivr.invalid
FIRMWARE_DOWNLOAD_HOST=firmware.invalid
DEVICE_OTA_FIRMWARE_DOWNLOAD_HOST=firmware.invalid

# Keep every outbound integration off.
PLATFORM_ADDRESS_VALIDATOR=noop
NOTIFICATIONSERVICE_SENDER_APNS=noop
NOTIFICATIONSERVICE_SENDER_GCM=noop
